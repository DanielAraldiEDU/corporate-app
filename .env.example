# FieldOps mobile app configuration. Copy to `.env.local` (git-ignored) and adjust.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time — never put secrets here.

# Mock API base URL. Leave unset in development to auto-detect:
#   - the Metro dev-server host IP (works for simulators, emulators and physical devices on the same Wi-Fi),
#   - otherwise http://10.0.2.2:3000 on Android emulators and http://localhost:3000 on the iOS Simulator.
# Set it explicitly for physical devices if auto-detection fails, e.g. your computer's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Port used when the URL is auto-detected (must match mock-api PORT).
EXPO_PUBLIC_API_PORT=3000

# Foreground device check-in interval in seconds.
EXPO_PUBLIC_CHECKIN_INTERVAL_SECONDS=30
